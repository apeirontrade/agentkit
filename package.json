{
  "name": "agentkit",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "pnpm --filter @agentkit/db generate",
    "db:migrate": "pnpm --filter @agentkit/db migrate",
    "x402:smoke": "tsx scripts/x402-apify-smoke.ts",
    "indexer:smoke": "tsx scripts/indexer-smoke.ts",
    "scoring:demo": "tsx scripts/scoring-demo.ts",
    "provenance:score": "tsx scripts/provenance-score.ts"
  },
  "dependencies": {
    "@agentkit/chain-indexer": "workspace:*",
    "@agentkit/provenance": "workspace:*",
    "@agentkit/scoring": "workspace:*",
    "@agentkit/x402-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
